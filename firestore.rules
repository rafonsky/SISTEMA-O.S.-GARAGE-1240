rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só permite acesso a quem estiver autenticado (mesmo autenticação anônima,
    // que o app já faz sozinho). Isso impede que qualquer robô na internet
    // leia/escreva direto na API do Firestore sem passar pelo site.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
