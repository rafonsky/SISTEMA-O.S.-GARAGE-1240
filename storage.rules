rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Só membros (quem tem documento em usuarios/{uid}) lêem e enviam arquivos.
    match /{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }
  }
}
